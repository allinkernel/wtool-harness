<?xml version="1.0" encoding="UTF-8"?>
<!--
  harness —— 给 AI 助手的项目记忆（笔记、技能定义、时间线）。:wtool-base:wtool-base:用户文档。只有文档，没有工具。:themes/typora/lightmind:lightmind:Typora 的一个自制主题。

  **只可发布，不可安装。**

  这里刻意没有 <link> / <env>：这个仓库没有需要铺到 $HOME 的东西，
  也没有需要编译的产物。它参与 wtool 的唯一方式是"能被发布"，
  这样别人从发布页把所有包下下来，就能拼出一个完整的工作区。

  表格里它会显示成 install 不支持、publish 可执行 —— 那是准确的。
-->
<wtool schema="1" id="harness" priority="100">
  <!-- 打源码包推到本仓 release。包内第一层是 wtool/，解压后与 repo sync 一致 -->
  <publish kind="source"/>
</wtool>
